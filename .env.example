# Environment Configuration Template
# Copy to .env and fill in values

# ── Application ─────────────────────────────────────────────
APP_NAME="AI Document Screening System"
APP_ENV=development
DEBUG=true

# ── API ─────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=data/database/passport_screening.db

# ── OCR Settings ─────────────────────────────────────────────
OCR_LANGUAGES=en
OCR_GPU=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Streamlit ────────────────────────────────────────────────
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
